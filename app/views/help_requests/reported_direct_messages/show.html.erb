<div class="max-w-2xl mx-auto px-4 py-8">
  <%= render "shared/back_header", path: help_request_path(@help_request), title: "Reported Message" %>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-sf-sand/20 dark:border-gray-700 p-6">
    <% if @direct_message %>
      <div class="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400 mb-4">
        <%= render "shared/avatar", user: @direct_message.sender, size: :sm %>
        <strong class="text-sf-black dark:text-white"><%= @direct_message.sender.name %></strong>
        <span>&middot;</span>
        <%= time_ago_in_words(@direct_message.created_at) %> ago
      </div>
      <p class="text-gray-700 dark:text-gray-300 whitespace-pre-wrap"><%= format_user_content(@direct_message.body) %></p>
    <% else %>
      <p class="text-gray-500 dark:text-gray-400">This reported message is no longer available.</p>
    <% end %>
  </div>
</div>
